PORT=3020
SESSION_SECRET=replace-with-a-long-random-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tapflow_user
DB_PASSWORD=replace-with-database-password
DB_NAME=tapflow_workbench

CANVAS_DB_HOST=127.0.0.1
CANVAS_DB_PORT=3306
CANVAS_DB_USER=tapflow_user
CANVAS_DB_PASSWORD=replace-with-database-password
CANVAS_DB_NAME=tapflow_canvas_content
PROJECT_CATALOG_BACKEND=local
PROJECT_CATALOG_HOST=127.0.0.1
PROJECT_CATALOG_PORT=3306
PROJECT_CATALOG_USER=
PROJECT_CATALOG_PASSWORD=
PROJECT_CATALOG_NAME=sd2_project_mgmt
PROJECT_CATALOG_MAIN_DB=sd2_studio

INITIAL_ADMIN_USERNAME=吴逸翔
INITIAL_ADMIN_PASSWORD=replace-with-initial-admin-password

PROJECTS_DIR=./data/projects
BACKUP_ROOT_DIR=./data/backups
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_RETENTION_DAYS=14

OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=shotflow-assets
OBJECT_STORAGE_ACCESS_KEY=replace-with-object-storage-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-object-storage-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PREFIX=shotflow
OBJECT_STORAGE_AUTO_MIRROR=false
OBJECT_STORAGE_PUBLIC_BASE_URL=

MIVO_BASE_URL=https://aigc.xindong.com
MIVO_API_KEY=replace-with-mivo-user-sub
OPENAI_BASE_URL=https://llm-proxy.tapsvc.com
OPENAI_API_KEY=replace-with-openai-compatible-api-key
LLM_BASE_URL=https://llm-proxy.tapsvc.com
LLM_API_KEY=replace-with-llm-api-key
# 画布 Cindy 的聊天 + 默认 Skill 模式对所有登录账号开放，正常情况下这两行都留空/不写。
# CINDY_ASSISTANT_RESTRICT_USER_IDS 只在需要临时收回时填（逗号分隔 id；空 = 不限制）。
# 高级 Skill 模式（一键出片 / 电影大师）按名单开；不写则沿用下面那行遗留的
# CINDY_ASSISTANT_ALLOWED_USER_IDS，都没有时只对用户 1 开放。
CINDY_ASSISTANT_RESTRICT_USER_IDS=
CINDY_ASSISTANT_ADVANCED_MODE_USER_IDS=1
# 遗留变量：以前是「谁能用画布 Cindy」，现在只作为高级模式名单的兜底来源。
CINDY_ASSISTANT_ALLOWED_USER_IDS=1
CINDY_ASSISTANT_MODEL=gpt-5.5
CINDY_ASSISTANT_TIMEOUT_MS=120000

# Cindy / Shotflow paid generation is opt-in. Existing plugin tokens do not
# receive generation scopes automatically when this switch is enabled.
SHOTFLOW_PLUGIN_GENERATION_ENABLED=false
SHOTFLOW_PLUGIN_GENERATION_TEXT_ENABLED=true
SHOTFLOW_PLUGIN_GENERATION_IMAGE_ENABLED=true
SHOTFLOW_PLUGIN_GENERATION_VIDEO_ENABLED=true
SHOTFLOW_PLUGIN_MAX_GENERATION_UNITS=20
SHOTFLOW_PLUGIN_PLAN_TTL_SECONDS=600
SHOTFLOW_PLUGIN_MAX_WAIT_SECONDS=90

MOGE_SERVICE_URL=http://127.0.0.1:8091
MOGE_SERVICE_TOKEN=replace-with-a-long-random-service-token
MOGE_TIMEOUT_MS=180000
MOGE_ALLOW_LOCAL_FALLBACK=true

SUBJECT_MATTING_SERVICE_URL=http://127.0.0.1:8092
SUBJECT_MATTING_SERVICE_TOKEN=replace-with-a-long-random-service-token
SUBJECT_MATTING_TIMEOUT_MS=180000
SUBJECT_MATTING_ALLOW_LOCAL_FALLBACK=true

# RealSR NCNN/Vulkan AI 高清增强 worker（4090 机器默认端口 8093）。
MEDIA_ENHANCE_SERVICE_URL=http://172.26.166.238:8093
MEDIA_ENHANCE_SERVICE_TOKEN=replace-with-a-long-random-service-token
MEDIA_ENHANCE_IMAGE_TIMEOUT_MS=1800000
MEDIA_ENHANCE_VIDEO_TIMEOUT_MS=43200000
MEDIA_ENHANCE_POLL_INTERVAL_MS=1000
# 允许 4K 素材 4x 到 16K；worker 端也必须设置同一个或更小的上限。
MEDIA_ENHANCE_MAX_OUTPUT_PIXELS=134217728
